{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "iChun (Original Author)",
    "EthanVisagie (Continuation)"
  ],
  "contact": {
    "homepage": "${mod_url_home}",
    "sources": "${mod_url_sources}",
    "issues": "${mod_url_issues}"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.ichun.mods.ding.loader.fabric.LoaderFabricClient"
    ],
    "modmenu": [
      "me.ichun.mods.ding.loader.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "ding.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=25"
  }
}
